# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets - signing keys, passwords and credentials. Never commit these.
# Android upload/release keystores and their passwords
*.jks
*.keystore
key.properties
**/key.properties
local.properties
# iOS / Apple signing certificates, profiles and API keys
*.p12
*.cer
*.mobileprovision
*.provisionprofile
*.p8
AuthKey_*.p8
# Generic private keys and environment files
*.pem
*.key
.env
.env.*
!.env.example
# Firebase / Google service configs and Play Console service accounts
google-services.json
GoogleService-Info.plist
*service-account*.json
# Release builds (contain your signed app)
*.aab
*.apk
*.ipa
